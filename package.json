{
  "name": "versailles",
  "version": "0.1.2",
  "description": "Versailles — lightweight HTML desktop widget host for Windows",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify:acl": "node scripts/verify-acl.mjs",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/verify-acl.mjs && node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/verify-acl.mjs && node scripts/run-tauri.mjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "fuse.js": "^7.1.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
