{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Versailles",
  "version": "0.1.2",
  "identifier": "com.versailles.widgets",
  "build": {
    "beforeDevCommand": "npm run verify:acl && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run verify:acl && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
