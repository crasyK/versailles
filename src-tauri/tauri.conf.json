{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Versailles",
  "version": "0.11.1",
  "identifier": "com.versailles.widgets",
  "build": {
    "beforeDevCommand": "npm run verify:acl && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run verify:acl && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default", "welcome"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NTlEQUQxMzQ3QzExOUUKUldTZUVYdzAwZHBaZGc3WEQrUUZIQ3BxVGp2RGxEOEhUSW1UVkpLYWNRSENDT0pLQTFWVjMyWC8K",
      "endpoints": ["https://github.com/crasyK/versailles/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
